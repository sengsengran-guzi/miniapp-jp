# 本地开发环境（mode=development，默认）
# 自动加载条件：pnpm dev:mp-weixin / pnpm dev / 任何不显式指定 --mode 的命令

# 后端请求地址（ruoyi-admin 本地端口 8080；两个小程序共用同一后端，按 clientid 区分）
# ⚠️ 用 localhost 而非 127.0.0.1：本机系统代理（clash）的 bypass 列表含 localhost / 192.168.0.0/16
# 但不含字面 127.0.0.1 —— 微信开发者工具走系统代理，请求 127.0.0.1:8080 会被代理吞掉（hang）；
# localhost:8080 命中 bypass 直连后端。H5（浏览器忽略系统代理）两者皆可。
VITE_SERVER_BASEURL = 'http://localhost:8080'
VITE_SERVER_BASEURL_SECONDARY = 'http://localhost:8080'

# 微信 AppID。
# ⚠️ 一期占位 'wxMOCKMOCKMOCKMOCK'（Kevin 2026-08-06 定）：全 mock 短路（登录/支付/扫码全跳过，
#    纯离线调试）。真 appid 到位后按 doc/jp/phase-plan.md「appid 回补清单」#1 换真值，
#    business code 看到非 wxMOCK 前缀会自动切真链路（uni.login → 后端 real adapter），无需改代码。
VITE_WX_APPID = 'wxMOCKMOCKMOCKMOCK'

# 本地 mock 支付开关（仅本地）：true 时付费单跳过真实 uni.requestPayment，
# 直接调后端 simulate-callback 驱动结算 → 模拟器免真机付款走完业务全流程。
# 与 VITE_WX_APPID 解耦：可「真登录 + 假支付」。staging/prod 无此项 → 走真支付。
VITE_MOCK_PAY = true

# dev 保留 console.log/warn/error 方便调试（vite.config.ts esbuild.drop 关闭）
VITE_DELETE_CONSOLE = false

# 开发期显示底部「测试」tab —— 本项目未启用（tabbar 固定 2 格：首页 / 我的）
VITE_SHOW_TEST_TAB = false
