# Staging 环境（mode=staging）
# 用法：pnpm build:mp:staging / pnpm upload:mp --robot=1 --mode=staging（miniprogram-ci 上传体验版）

# Staging 后端（已备案 HTTPS 域名 guzi.tianda.studio；与现有小程序同一后端，按 clientid 区分）
# ⚠️ 新小程序需在自己的微信后台把该域名加进「request 合法域名」白名单（真 appid 到位后做）
VITE_SERVER_BASEURL = 'https://guzi.tianda.studio'
VITE_SERVER_BASEURL_SECONDARY = 'https://guzi.tianda.studio'

# 微信 appid（与 manifest.config.ts mp-weixin.appid 一致）
# ⚠️ 一期占位 wxMOCK（Kevin 2026-08-06 定）：等甲方新小程序账号申请通过后由 Kevin 换真值
#    （doc/jp/phase-plan.md「appid 回补清单」#1）。占位期不能上传体验版 —— 上传需要真 appid + 上传私钥。
VITE_WX_APPID = 'wxMOCKMOCKMOCKMOCK'

# staging 体验版上传到微信，删 console.log（保留 console.error 便于线上排查）
VITE_DELETE_CONSOLE = true

# 「测试」tab —— 本项目未启用
VITE_SHOW_TEST_TAB = false
