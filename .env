# 公共环境变量（所有 mode 加载，被 .env.<mode> 覆盖）
#
# vite mode 规则（uni-app + unibest）：
#   pnpm dev:mp-weixin    → mode=development → 加载 .env + .env.development（本地 mac dev，wxMOCK 短路登录）
#   pnpm build:mp --mode=staging → mode=staging  → 加载 .env + .env.staging（体验版）
#   正式版发版走人工（微信公众平台提审）

# 应用基础（miniapp-jp / 谷子宇宙拼团 · 日本代购）
VITE_APP_TITLE = '谷子宇宙拼团'
VITE_APP_PORT = 9100

# uni-app 内部标识，固定（不同环境共用，与微信 appid 无关）
VITE_UNI_APPID = '__UNI__GZJP01'

# h5 部署 base
VITE_APP_PUBLIC_BASE = /

# vite 代理（dev 时未启用）
VITE_APP_PROXY_ENABLE = false
VITE_APP_PROXY_PREFIX = '/dev-api'

# 认证模式：sa-token 单 token
VITE_AUTH_MODE = 'single'

# 微信小程序 client（与后端 sys_client.client_id / wx.miniapp.apps 的 key 对齐）。
# ⚠️ 本小程序恒为 mp-applet-gz-jp —— 后端按 clientid 路由到对应 appid 配置（GZ-SYS-020 / FLOW:F-JP-00.step1）。
# 写错会直接收到「未配置的小程序客户端」报错（不会静默串到另一个小程序），这是预期的护栏行为。
VITE_APP_CLIENT_ID = 'mp-applet-gz-jp'

# 默认租户（与现有小程序同租户，共用后端主数据）
VITE_APP_TENANT_ID = '1001'

VITE_FALLBACK_LOCALE = 'zh-Hans'
VITE_COPY_NATIVE_RES_ENABLE = false
